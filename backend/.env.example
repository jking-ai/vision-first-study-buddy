# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Vertex AI / Gemini
GEMINI_MODEL=gemini-3.1-pro-preview

# Firebase Storage
FIREBASE_STORAGE_BUCKET=your-gcp-project-id.appspot.com

# CORS (comma-separated origins). Default in code is empty (non-permissive);
# you must set this explicitly even for local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# File upload limits
MAX_FILE_SIZE_MB=20

# Interactive docs (Swagger UI / ReDoc / OpenAPI schema).
# Default false — production should never expose the API surface map.
# Set to true locally if you want /docs and /redoc back.
DOCS_ENABLED=false
