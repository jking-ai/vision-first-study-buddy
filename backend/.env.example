# Google Cloud Platform
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1

# Vertex AI / Gemini
GEMINI_MODEL=gemini-3.1-pro-preview

# Firebase Storage
FIREBASE_STORAGE_BUCKET=your-gcp-project-id.appspot.com

# CORS (comma-separated origins). Default in code is empty (non-permissive);
# you must set this explicitly even for local dev.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# File upload limits
MAX_FILE_SIZE_MB=20

# Interactive docs (Swagger UI / ReDoc / OpenAPI schema).
# Default false — production should never expose the API surface map.
# Set to true locally if you want /docs back.
DOCS_ENABLED=false

# Voice Coach (Gemini Live API)
VOICE_ENABLED=false
GEMINI_LIVE_API_KEY=your-gemini-live-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
VOICE_COACH_VOICE=Kore
VOICE_ALLOWED_VOICES=Kore,Puck,Charon,Aoede,Fenrir,Leda,Orus,Zephyr
VOICE_SESSION_MAX_SECONDS=180
VOICE_SESSIONS_PER_DEVICE_PER_DAY=2
VOICE_SESSIONS_PER_DAY_GLOBAL=20
VOICE_MAX_CONCURRENT_SESSIONS=2
VOICE_IDLE_TIMEOUT_SECONDS=45
VOICE_START_TIMEOUT_SECONDS=5
VOICE_MAX_GUIDE_BYTES=32768
VOICE_AUDIO_IN_PRICE_PER_M=3.0
VOICE_AUDIO_OUT_PRICE_PER_M=12.0
VOICE_QUIZ_QUESTIONS=5
